    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.11.2",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
